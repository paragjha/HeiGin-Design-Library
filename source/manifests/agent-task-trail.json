{
  "name": "agent-task-trail",
  "category": "crm",
  "entry": "components/crm/agent-task-trail.tsx",
  "description": "A live timeline of an agent working through a task: each step with its service, status and time, sub-steps on a branching rail, and an approval gate for steps that need a person.",
  "exports": [
    "AgentTaskTrail"
  ],
  "types": [
    "AgentStep",
    "AgentStepApproval",
    "AgentStepStatus",
    "AgentSubstep",
    "AgentTaskTrailProps"
  ],
  "client": true,
  "files": [
    "packages/ui/src/components/crm/agent-task-trail.tsx",
    "packages/ui/src/components/crm/agent.module.css",
    "packages/ui/src/components/ui/button.module.css",
    "packages/ui/src/components/ui/button.tsx",
    "packages/ui/src/components/ui/heigin-mark.tsx",
    "packages/ui/src/components/ui/loader.tsx",
    "packages/ui/src/components/ui/spinner.module.css",
    "packages/ui/src/components/ui/spinner.tsx",
    "packages/ui/src/components/ui/thinking-orb.tsx",
    "packages/ui/src/components/ui/visually-hidden.tsx",
    "packages/ui/src/lib/cn.ts"
  ],
  "styles": [
    "packages/ui/src/styles/tokens.css"
  ],
  "internalDependencies": [
    "button",
    "heigin-mark",
    "loader",
    "spinner",
    "thinking-orb",
    "visually-hidden"
  ],
  "npmDependencies": {
    "lucide-react": "^1.55.0",
    "react": ">=18.2.0",
    "thinking-orbs": "^0.3.2"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "install": [
    "lucide-react",
    "thinking-orbs"
  ],
  "copyCommand": "node scripts/copy-component.mjs agent-task-trail --dest <your-app>/components/heigin"
}
