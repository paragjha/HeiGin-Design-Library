    "packages/ui/src/components/ui/field.tsx",
    "packages/ui/src/components/ui/input.module.css",
    "packages/ui/src/components/ui/native-select.tsx",
    "packages/ui/src/lib/cn.ts"
  ],
  "styles": [
    "packages/ui/src/styles/tokens.css"
  ],
  "internalDependencies": [
    "field"
  ],
  "npmDependencies": {
    "react": ">=18.2.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "install": [],
  "copyCommand": "node scripts/copy-component.mjs native-select --dest <your-app>/components/heigin"
}
