{
  "name": "tooltip",
  "category": "ui",
  "entry": "components/ui/tooltip.tsx",
  "description": "Supplementary label shown on hover and keyboard focus. Escape dismisses it. Wrap the app (or a region) in `TooltipProvider` to share delays between adjacent tooltips.",
  "exports": [
    "Tooltip",
    "TooltipProvider"
  ],
  "types": [
    "TooltipProps"
  ],
  "client": true,
  "files": [
    "packages/ui/src/components/ui/popup.module.css",
    "packages/ui/src/components/ui/tooltip.tsx",
    "packages/ui/src/lib/cn.ts"
  ],
  "styles": [
    "packages/ui/src/styles/tokens.css"
  ],
  "internalDependencies": [],
  "npmDependencies": {
    "@base-ui/react": "^1.9.0",
    "react": ">=18.2.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "install": [
    "@base-ui/react"
  ],
  "copyCommand": "node scripts/copy-component.mjs tooltip --dest <your-app>/components/heigin"
}
