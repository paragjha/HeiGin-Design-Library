{
  "name": "dialog",
  "category": "ui",
  "entry": "components/ui/dialog.tsx",
  "description": "Root of a modal dialog. Accepts `open`, `defaultOpen` and `onOpenChange`.",
  "exports": [
    "Dialog",
    "DialogClose",
    "DialogContent",
    "DialogHeader",
    "DialogTrigger"
  ],
  "types": [
    "DialogContentProps"
  ],
  "client": true,
  "files": [
    "packages/ui/src/components/ui/button.module.css",
    "packages/ui/src/components/ui/button.tsx",
    "packages/ui/src/components/ui/dialog.module.css",
    "packages/ui/src/components/ui/dialog.tsx",
    "packages/ui/src/components/ui/icon-button.tsx",
    "packages/ui/src/components/ui/spinner.module.css",
    "packages/ui/src/components/ui/spinner.tsx",
    "packages/ui/src/lib/cn.ts"
  ],
  "styles": [
    "packages/ui/src/styles/tokens.css"
  ],
  "internalDependencies": [
    "button",
    "icon-button",
    "spinner"
  ],
  "npmDependencies": {
    "@base-ui/react": "^1.9.0",
    "lucide-react": "^1.55.0",
    "react": ">=18.2.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "install": [
    "@base-ui/react",
    "lucide-react"
  ],
  "copyCommand": "node scripts/copy-component.mjs dialog --dest <your-app>/components/heigin"
}
