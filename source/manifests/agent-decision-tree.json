{
  "name": "agent-decision-tree",
  "category": "crm",
  "entry": "components/crm/agent-decision-tree.tsx",
  "description": "A queue of decisions an agent needs from a person, drawn as a tree: the question, the branches it considered, follow-up options with their consequences, and the agent's own pick. One click (or a number key) commits; the next decision slides in.",
  "exports": [
    "AgentDecisionTree"
  ],
  "types": [
    "AgentDecision",
    "AgentDecisionTreeProps",
    "DecisionBranch",
    "DecisionChoice",
    "DecisionOption"
  ],
  "client": true,
  "files": [
    "packages/ui/src/components/crm/agent-decision-tree.module.css",
    "packages/ui/src/components/crm/agent-decision-tree.tsx",
    "packages/ui/src/components/ui/button.module.css",
    "packages/ui/src/components/ui/button.tsx",
    "packages/ui/src/components/ui/heigin-mark.tsx",
    "packages/ui/src/components/ui/kbd.tsx",
    "packages/ui/src/components/ui/loader.tsx",
    "packages/ui/src/components/ui/spinner.module.css",
    "packages/ui/src/components/ui/spinner.tsx",
    "packages/ui/src/components/ui/thinking-orb.tsx",
    "packages/ui/src/components/ui/visually-hidden.tsx",
    "packages/ui/src/lib/cn.ts"
  ],
  "styles": [
    "packages/ui/src/styles/tokens.css"
  ],
  "internalDependencies": [
    "button",
    "heigin-mark",
    "kbd",
    "loader",
    "spinner",
    "thinking-orb",
    "visually-hidden"
  ],
  "npmDependencies": {
    "lucide-react": "^1.55.0",
    "react": ">=18.2.0",
    "thinking-orbs": "^0.3.2"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "install": [
    "lucide-react",
    "thinking-orbs"
  ],
  "copyCommand": "node scripts/copy-component.mjs agent-decision-tree --dest <your-app>/components/heigin"
}
