{
  "name": "toast",
  "category": "ui",
  "entry": "components/ui/toast.tsx",
  "description": "Returns `toast(options)` and `dismiss(id?)`. Must be used inside `ToastProvider`. Danger toasts are announced assertively; others politely.",
  "exports": [
    "ToastProvider",
    "useToast"
  ],
  "types": [
    "ToastOptions",
    "ToastProviderProps",
    "ToastTone"
  ],
  "client": true,
  "files": [
    "packages/ui/src/components/ui/toast.module.css",
    "packages/ui/src/components/ui/toast.tsx",
    "packages/ui/src/lib/cn.ts"
  ],
  "styles": [
    "packages/ui/src/styles/tokens.css"
  ],
  "internalDependencies": [],
  "npmDependencies": {
    "@base-ui/react": "^1.9.0",
    "lucide-react": "^1.55.0",
    "react": ">=18.2.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "install": [
    "@base-ui/react",
    "lucide-react"
  ],
  "copyCommand": "node scripts/copy-component.mjs toast --dest <your-app>/components/heigin"
}
