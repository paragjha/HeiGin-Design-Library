    "packages/ui/src/components/ui/input.module.css",
    "packages/ui/src/components/ui/search-input.tsx",
    "packages/ui/src/lib/cn.ts"
  ],
  "styles": [
    "packages/ui/src/styles/tokens.css"
  ],
  "internalDependencies": [
    "field"
  ],
  "npmDependencies": {
    "lucide-react": "^1.55.0",
    "react": ">=18.2.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "install": [
    "lucide-react"
  ],
  "copyCommand": "node scripts/copy-component.mjs search-input --dest <your-app>/components/heigin"
