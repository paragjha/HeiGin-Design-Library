{
  "name": "storage-scanner",
  "category": "ui",
  "entry": "components/ui/storage-scanner.tsx",
  "description": "A storage meter for a disk or a workspace: the total used, a bar of colourful dot-matrix segments, one per category, and a footer that suggests what to clear. While scanning the bar grows with a glowing edge; while clearing, sparks fly off the segment as it shrinks. Hover, focus or pick a category to light up its segment and read what's inside.",
  "exports": [
    "StorageScanner"
  ],
  "types": [
    "StorageCategory",
    "StorageScannerProps",
    "StorageScannerStatus",
    "StorageSuggestion"
  ],
  "client": true,
  "files": [
    "packages/ui/src/components/ui/button.module.css",
    "packages/ui/src/components/ui/button.tsx",
    "packages/ui/src/components/ui/spinner.module.css",
    "packages/ui/src/components/ui/spinner.tsx",
    "packages/ui/src/components/ui/storage-scanner.module.css",
    "packages/ui/src/components/ui/storage-scanner.tsx",
    "packages/ui/src/components/ui/visually-hidden.tsx",
    "packages/ui/src/lib/cn.ts"
  ],
  "styles": [
    "packages/ui/src/styles/tokens.css"
  ],
  "internalDependencies": [
    "button",
    "spinner",
    "visually-hidden"
  ],
  "npmDependencies": {
    "lucide-react": "^1.55.0",
    "react": ">=18.2.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "install": [
    "lucide-react"
  ],
  "copyCommand": "node scripts/copy-component.mjs storage-scanner --dest <your-app>/components/heigin"
}
