{
  "name": "agent-thinking",
  "category": "crm",
  "entry": "components/crm/agent-thinking.tsx",
  "description": "Shows an agent thinking: a timer with the thinking orb (or a spinner), each step as it happens, and a dithered dot visual that reshapes per step. When done, the steps fold into \"Thought for Ns\" and the answer takes their place.",
  "exports": [
    "AgentThinking"
  ],
  "types": [
    "AgentThinkingProps",
    "ThinkingShape",
    "ThinkingStep"
  ],
  "client": true,
  "files": [
    "packages/ui/src/components/crm/agent-thinking.module.css",
    "packages/ui/src/components/crm/agent-thinking.tsx",
    "packages/ui/src/components/ui/loader.tsx",
    "packages/ui/src/components/ui/spinner.module.css",
    "packages/ui/src/components/ui/spinner.tsx",
    "packages/ui/src/components/ui/thinking-orb.tsx",
    "packages/ui/src/lib/cn.ts"
  ],
  "styles": [
    "packages/ui/src/styles/tokens.css"
  ],
  "internalDependencies": [
    "loader",
    "spinner",
    "thinking-orb"
  ],
  "npmDependencies": {
    "lucide-react": "^1.55.0",
    "react": ">=18.2.0",
    "thinking-orbs": "^0.3.2"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "install": [
    "lucide-react",
    "thinking-orbs"
  ],
  "copyCommand": "node scripts/copy-component.mjs agent-thinking --dest <your-app>/components/heigin"
}
